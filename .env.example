# このファイルを .env にコピーして、環境に合わせて値を設定してください。
#   cp .env.example .env
# .env は .gitignore 済みです。実際の秘密情報を .env.example には書かないでください。

# --- 必須: Flaskアプリケーション設定 ---
# セッションの署名に使う秘密鍵。未設定だと起動時に ValueError で落ちます。
# gunicorn は --preload で起動するため、マスタプロセスが即座に終了し、
# restart: always と相まって無限クラッシュループになります(ログにDBの話は出ません)。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- 必須: データベース接続設定 ---
# アプリ側の接続とMySQLコンテナの初期化の双方がこの値を参照します。
# 値の二重管理による不一致を防ぐため、MYSQL_USER / MYSQL_DATABASE は用意していません。
# Docker Composeで起動する場合は "db"、ローカルのMySQLに繋ぐ場合は "localhost"
DB_HOST=db
DB_USER=rehab_user
DB_PASSWORD=
DB_NAME=rehab_db

# MySQLコンテナのrootパスワード (docker-compose.yml の db サービスが使用)
MYSQL_ROOT_PASSWORD=

# --- 初期管理者アカウント ---
# 職員が1人も登録されていない場合にのみ、この値で管理者を作成します。
# 初回ログイン時にパスワードの変更が強制されます。
# schema.sql に固定アカウントを埋め込む方式は廃止しました
# (既知の資格情報が全デプロイ環境に存在することになるため)。
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_OCCUPATION=管理者

# --- AIモデル選択 ---
# "gemini" (クラウドAPI) または "ollama" (ローカル)
LLM_CLIENT_TYPE=gemini

# --- Gemini (クラウド) を使用する場合 ---
GOOGLE_API_KEY=
# Rehab_RAG 配下のコンポーネントはこちらを参照します
GEMINI_API_KEY=

# --- Ollama (ローカル) を使用する場合 ---
# `ollama pull qwen3:8b` などで事前にダウンロードしたモデル名
OLLAMA_MODEL_NAME=qwen3:8b
# DockerからホストのOllamaに接続する場合は host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_USE_STRUCTURED_OUTPUT=true

# --- Graph RAG (Neo4j) 設定 (オプション) ---
# Graph RAGパイプラインを使う場合のみ設定してください
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
